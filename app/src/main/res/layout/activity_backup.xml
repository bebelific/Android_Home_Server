<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"/>

        <Button
            android:id="@+id/buttonPickDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Link Google Drive folder"/>

        <Button
            android:id="@+id/buttonClearDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlink Drive"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Also copy to USB drive (OTG)"/>
            <Switch
                android:id="@+id/swUsb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            android:id="@+id/buttonAllFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Grant All-files access (Android 10+)"/>

        <Button
            android:id="@+id/buttonRunNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Run backup now"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="HOW TO USE"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:text="1. Toggle Photo Backup on the dashboard\n2. New camera photos/videos copy every 15 min into PhotoBackup/device-name/ on the share\n3. Optional: 'Link Google Drive folder' → copies also upload to your Drive (one-time picker, no sign-in needed beyond Drive app)\n4. Optional: plug a USB OTG drive and switch on 'Also copy to USB drive'\n5. 'Run backup now' forces an immediate cycle\nNothing is ever deleted — it is a one-way archive."
            android:textColor="?android:attr/textColorSecondary"/>
    </LinearLayout>
</ScrollView>
